# Ouroboros — environment variables. Copy to .env for local dev. NEVER commit .env.
# In Cloud Run / Agent Engine these are set by Terraform; secrets are mounted from Secret Manager.

# --- Google Cloud (Phase 1) ---------------------------------------------------
GOOGLE_CLOUD_PROJECT=ouroboros-507503
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=True
OUROBOROS_REGION=us-central1
OUROBOROS_ENV=dev
LOG_LEVEL=INFO

# --- Parallel (Phase 1, 4) ----------------------------------------------------
# Local dev only — in Cloud Run this is read from Secret Manager (PARALLEL_API_KEY).
PARALLEL_API_KEY=
PARALLEL_GROUNDING_MODE=byok
PARALLEL_PROJECT_BUDGET_USD=10
# Local dev only — Cloud Run reads PARALLEL_WEBHOOK_SECRET from Secret Manager (set in Phase 7).
PARALLEL_WEBHOOK_SECRET=
# Set in Phase 5.6 — bearer token the public Toolbox proxy requires from Parallel Task callers.
PARALLEL_MCP_TOKEN=

# --- Networking (Phase 1, 7) ---------------------------------------------------
PUBLIC_BASE_URL=https://dashboard-api-dev.example.run.app

# --- Claim Ledger (Phase 2) ----------------------------------------------------
# docker-compose maps the toolbox container's port 5000 to host port 5001 (host 5000 is
# often taken by macOS AirPlay Receiver) — see docker-compose.yml.
TOOLBOX_MCP_URL=http://localhost:5001
DB_HOST=localhost
DB_NAME=ouroboros
DB_USER=app
# Local dev only — in Cloud Run this is read from Secret Manager (DB_PASSWORD).
DB_PASSWORD=
FIRESTORE_DATABASE=(default)
INTAKE_BUCKET=ouroboros-507503-intake-dev
ARTIFACTS_BUCKET=ouroboros-507503-artifacts-dev
PUBSUB_TOPIC_CLAIMS=claims.extracted
PUBSUB_TOPIC_VERIFICATION=verification.events

# --- Agents (Phase 5) -----------------------------------------------------------
AGENT_ENGINE_RESOURCE_NAME=
AUTO_RUN_AFTER_INGEST=true

# --- Dashboard & governance (Phase 8) --------------------------------------------
VERTEX_SEARCH_DATASTORE_ID=
SHEETS_EXPORT_ID=
SLACK_WEBHOOK_URL=

# --- Demo / submission (Phase 9-10) ----------------------------------------------
SUBMISSION_AT=
PUBLIC_READONLY_PROJECT=
