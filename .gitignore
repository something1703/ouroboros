# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/

# uv
.python-version.local

# Node / web
web/node_modules/
web/dist/
web/.vite/
node_modules/

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
service-account*.json

# Terraform (the provider lock file IS committed — it pins versions for reproducibility)
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/*.tfplan
infra/**/crash.log
infra/**/override.tf
infra/**/override.tf.json

# Fixtures: large/real media go to GCS, not git (check-added-large-files also
# catches this at 2MB). Small synthetic fixtures we authored ourselves (e.g. the
# compact sample screenplay PDFs) are committed directly — no GCS round trip
# needed just to run `make test-live` or `make seed` on a fresh clone.
fixtures/cuts/*.mp4
fixtures/cuts/*.mov
!fixtures/**/.gitkeep
!fixtures/**/*.yaml
!fixtures/**/*.labels.yaml

# Evidence screenshots/gifs can be large; keep by exception
docs/evidence/**/*.mp4
docs/evidence/**/*.mov

# Editors
.vscode/*
!.vscode/extensions.json
.idea/

# Scratch/throwaway scripts used for live GCP diagnostics during development —
# never meant to be committed, underscore-prefixed by convention to mark them as such.
scripts/_*
