# Copy to .env for local dev. Both values are public identifiers (not secrets) --
# the Client ID is meant to ship in frontend code, and the API base URL is just the
# deployed Cloud Run service's own public address.
VITE_API_BASE_URL=https://dashboard-api-492372502792.us-central1.run.app
VITE_GOOGLE_CLIENT_ID=492372502792-58fivlikum2o43klt2gbb9j16fqqr1qb.apps.googleusercontent.com

# Optional. ISO-8601 timestamp of the actual hackathon submission (PHASE_08.md
# §8.3's "since submission" feed divider). Leave unset until submission actually
# happens -- the divider simply doesn't render rather than showing a fabricated date.
# VITE_SUBMISSION_AT=2026-09-10T02:30:00+05:30
